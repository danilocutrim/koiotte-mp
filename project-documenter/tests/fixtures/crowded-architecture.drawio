        <mxCell id="grp-proxy" value="edge-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="1">
